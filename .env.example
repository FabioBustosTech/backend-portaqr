# ───────── Configuración del servidor ─────────
NODE_ENV=development
SERVER_PORT=3001
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000

# ───────── MongoDB (BD unificada "sistema") ─────────
MONGO_USERNAME=root
MONGO_PASSWORD=example
MONGO_PORT=27017
MONGO_DATABASE=sistema
MONGO_HOST=mongo
MONGODB_URI=mongodb://${MONGO_USERNAME}:${MONGO_PASSWORD}@${MONGO_HOST}:${MONGO_PORT}/${MONGO_DATABASE}?authSource=admin

# ───────── JWT (RS256) ─────────
# JWT_PRIVATE_KEY / JWT_PUBLIC_KEY aceptan DOS formatos:
#   a) Contenido PEM directo (recomendado para Railway/despliegues), con \n literales:
#      JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----"
#      JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIj...\n-----END PUBLIC KEY-----"
#   b) Ruta relativa a un archivo PEM (formato local):
JWT_PRIVATE_KEY=keys/jwt-private.pem
JWT_PUBLIC_KEY=keys/jwt-public.pem
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# ───────── Webpay (transbank) ─────────
WEBPAY_COMMERCE_CODE=YOUR_WEBPAY_COMMERCE_CODE_HERE
WEBPAY_API_KEY=YOUR_WEBPAY_API_KEY_HERE
WEBPAY_ENVIRONMENT=integration
# Base del frontend para redirecciones post-pago (default: http://localhost:3000)
FRONTEND_BASE_PATH=http://localhost:3000
# URLs de retorno post-pago (vacías = derivadas de FRONTEND_BASE_PATH)
WEBPAY_SUCCESS_URL=
WEBPAY_FAIL_URL=
WEBPAY_ERROR_URL=

# ───────── Email (nodemailer + EJS) ─────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-app-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_VERIFICATION_EXPIRY=3600
FRONTEND_URL=http://localhost:3000
# SPEC-020: correo de bienvenida (primer login verificado). Default true.
# Solo 'false' explícito lo desactiva (útil en local para tests manuales).
WELCOME_EMAIL_ENABLED=true

# ---------- SPEC-030: Newsletter (sync best-effort a qr-cms) ----------
# Base del CMS para POST /api/newsletter/sync (server-to-server).
CMS_BASE_URL=http://localhost:3005
# Debe coincidir con NEWSLETTER_API_KEY de qr-cms (header x-newsletter-api-key).
CMS_NEWSLETTER_API_KEY=
# Kill-switch del sync. Solo 'false' explícito lo desactiva.
NEWSLETTER_SYNC_ENABLED=true

# ───────── App (opcional) ─────────
API_PREFIX=
ENABLE_SWAGGER=true

# ---------- Cloudflare R2 (SPEC-002: imagenes de portada QR multilink) ----------
# Token de API R2 (Cloudflare Dashboard > R2 > Manage R2 API tokens)
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_key
# Endpoint S3 del bucket: https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
# Nombre del bucket creado en R2
CLOUDFLARE_R2_BUCKET_NAME=portaqr-assets
# URL publica vinculada al bucket (dominio custom o *.r2.dev provisto por CF)
# Ej prod: https://images.portaqr.cl  |  Ej dev: https://pub-xxxx.r2.dev
CLOUDFLARE_R2_PUBLIC_URL=https://images.portaqr.cl
# Limite de tamano del archivo de entrada en bytes (opcional, default 5MB)
CLOUDFLARE_R2_MAX_UPLOAD_SIZE=5242880

# ---------- SPEC-005: PDFs de items QR multilink ----------
# Límite de tamaño del PDF de entrada en bytes (default 2 MB)
PDF_MAX_UPLOAD_SIZE=2097152
# Máximo de items PDF por QR multilink (default 2)
MAX_PDF_ITEMS_PER_QR=2

# ---------- SPEC-016: Foto de la mascota en PetTag ----------
# Límite de tamaño de la foto de entrada en bytes (default 5 MB; se re-encodea a WebP ≤512×512)
PET_TAG_MAX_UPLOAD_SIZE=5242880

# ---------- SPEC-008: Hardening perimetral ----------
# Origenes CORS permitidos separados por coma (vacio o * en dev)
# Ej prod: https://app.portaqr.cl,https://admin.portaqr.cl
CORS_ORIGINS=
# Rate limiting global (req por ventana TTL en MILISEGUNDOS — throttler v6)
# OJO: con TTL < 1000ms el throttler queda inerte (ventana expira al instante)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# Limite por-ruta en endpoints sensibles (login/refresh/registro/contacto) - default 5/min
# En dev/CI subirlo (ej. 1000) para no bloquear suites E2E que comparten IP
THROTTLE_SENSITIVE_LIMIT=5
THROTTLE_SENSITIVE_TTL=60000

# ---------- SPEC-011: Rate limiting flujo público QR (Capa B) ----------
# Clave por idQr (el BFF solo ve la IP interna de qr-app — la IP real del
# visitante vive en la Capa A del route handler, ver SPEC-011 §4.2). TTL en ms.
THROTTLE_QR_TTL_MS=60000
# GET /qr/public/:id — por idQr (QR viral / bot enfocado en un QR)
THROTTLE_QR_PUBLIC_IDQR_MAX=60
# POST /scan/stats — por idQr (anti-inflado de estadísticas)
THROTTLE_QR_SCAN_IDQR_MAX=120
# GET /qr/seo-idqr — por IP interna (solo crawlers/sitemap)
THROTTLE_QR_SEO_MAX=10
# Sobrecarga global del BFF (guard global por IP interna de qr-app; los
# @Throttle por ruta sobreescriben el límite por idQr)
THROTTLE_QR_OVERLOAD_MAX=1000
